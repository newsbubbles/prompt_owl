# To use this as your environment file, rename this to `.env`
# If you want this to be system-wide, .bashrc it or add to PATH in Winblows

# Any OpenAI-compatible endpoint. The base URL is the origin -- prowl appends the path.
#   vLLM              http://localhost:8000
#   Ollama            http://localhost:11434   (its OpenAI-compatible paths, NOT /api/generate:
#                                               that shape returns `response`, not choices[].text)
#   llama.cpp server  http://localhost:8080
#   OpenRouter        https://openrouter.ai/api
PROWL_VLLM_ENDPOINT=http://localhost:8000
PROWL_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# If using OpenRouter or another paid API, even openAI
# PROWL_VENDOR_API_KEY=...

# Only if your server puts completions somewhere unusual
# PROWL_COMPLETIONS_ENDPOINT=/v1/completions

# Talk to a chat endpoint by assistant prefill: the growing document goes into a pre-started
# assistant turn. Same mechanism, different envelope, ~19-91% more tokens.
# PROWL_CHAT=1

# Studio: refuse a run whose worst case exceeds this many completion tokens
# PROWL_MAX_COMPLETION_TOKENS=20000
# PROWL_WORKSPACE_ROOT=~/.prowl/workspaces
# PROWL_EMBED_MODEL=baai/bge-m3

# Comfy
PROWL_COMFY_ENDPOINT=127.0.0.1:8188

# Fal (for the Fal.ai tool)
# FAL_KEY=...
